<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_srv_skeleton_card"
    android:padding="10dp"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.06"
    app:shimmer_highlight_alpha="0.22"
    app:shimmer_duration="1100">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/bg_srv_skeleton_rect" />

        <!-- 主标题：约 60% 宽（用 dp 近似，适配性更好） -->
        <View
            android:layout_width="180dp"
            android:layout_height="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_srv_skeleton_rect" />

        <!-- 副标题：约 35% 宽 -->
        <View
            android:layout_width="105dp"
            android:layout_height="10dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_srv_skeleton_rect" />
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>